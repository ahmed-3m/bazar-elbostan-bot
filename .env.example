# Copy to .env for local reference only — actual values go into
# `supabase secrets set`, never committed here.

# Facebook Page Access Token (Meta → Messenger API Settings → section 2)
PAGE_ACCESS_TOKEN=

# Any random string — must match what you type into Meta's Webhooks
# "Verify token" field
VERIFY_TOKEN=

# OpenRouter API key for reply generation
OPENROUTER_API_KEY=

# Optional — defaults to google/gemini-2.0-flash-001 if unset
OPENROUTER_MODEL=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Edge
# Functions runtime — do not set these manually.
